{
  "expo": {
    "name": "Pocket Reef",
    "slug": "pocket-reef",
    "scheme": "pocketreef",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#061826",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#061826"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alexrafalski.pocketreef",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Pocket Reef uses Face ID so you can sign in to your account without typing your password.",
        "ITSAppUsesNonExemptEncryption": false,
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "package": "com.alexrafalski.pocketreef",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#061826"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#38e1c6",
          "defaultChannel": "reef-care"
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Pocket Reef to use Face ID to sign you in."
        }
      ],
      "expo-font",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pocket Reef uses your photo library so you can attach pictures of your tank and its animals to journal entries and observations.",
          "cameraPermission": "Pocket Reef uses the camera so you can photograph your tank and its animals for your journal."
        }
      ]
    ]
  }
}
